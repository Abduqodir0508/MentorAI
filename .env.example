# Supabase Configuration (Template - do NOT put real credentials here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Configuration (Creator superuser override)
ADMIN_EMAILS=admin@yourdomain.com
ADMIN_SECRET_KEY=your_secure_random_admin_secret_key_here

# Payment Gateway Configuration (Local simulated / Payme / Click / Stripe)
PAYMENT_PROVIDER=simulated
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
